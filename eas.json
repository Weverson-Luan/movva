{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "20.18.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },

    "movva-preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": { "CLIENT": "movva" }
    },
    "movva": {
      "extends": "base",
      "channel": "production",
      "env": { "CLIENT": "movva" }
    },

    "cinbal-preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": { "CLIENT": "cinbal" }
    },
    "cinbal": {
      "extends": "base",
      "channel": "production",
      "env": { "CLIENT": "cinbal" }
    },

    "jornada-preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": { "CLIENT": "jornada" }
    },
    "jornada": {
      "extends": "base",
      "channel": "production",
      "env": { "CLIENT": "jornada" }
    }
  },
  "submit": {
    "movva": {
      "ios": { "ascAppId": "PREENCHER", "appleTeamId": "PREENCHER" },
      "android": { "serviceAccountKeyPath": "./clients/movva/google-service-account.json", "track": "internal" }
    },
    "cinbal": {
      "ios": { "ascAppId": "PREENCHER", "appleTeamId": "PREENCHER" },
      "android": { "serviceAccountKeyPath": "./clients/cinbal/google-service-account.json", "track": "internal" }
    },
    "jornada": {
      "ios": { "ascAppId": "PREENCHER", "appleTeamId": "PREENCHER" },
      "android": { "serviceAccountKeyPath": "./clients/jornada/google-service-account.json", "track": "internal" }
    }
  }
}
