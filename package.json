{
  "name": "movva",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:movva": "cross-env CLIENT=movva expo start --clear",
    "start:padaria": "cross-env CLIENT=padaria expo start --clear",
    "config": "expo config --type public",
    "new-client": "node scripts/new-client.js",
    "build:all": "bash scripts/build-all.sh",
    "update:all": "bash scripts/update-all.sh",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.19",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/react": "^19.3.0",
    "cross-env": "^7.0.3",
    "husky": "9.1.7",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
